# Copy this file to custom-login-app/.env and replace the placeholder values.

PORT=5000
BASE_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-string-for-custom-login

# This demo uses Cognito's direct username/password API, not Hosted UI.
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-custom-login-client-id
COGNITO_CLIENT_SECRET=your-custom-login-client-secret

# Keep USER_PASSWORD_AUTH unless you add support for a different auth flow.
COGNITO_AUTH_FLOW=USER_PASSWORD_AUTH
